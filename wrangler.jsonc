{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hop",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-22",
  "workers_dev": false,
  "preview_urls": false,
  // Local dev: http://go.localhost:4696 (keep in step with SHORT_DOMAIN below). There's no
  // dev.host or route here on purpose: the Worker then sees the real Host header, so the local
  // sign-in shortcut can tell a genuine *.localhost request from a DNS-rebinding one.
  // `npm run deploy` adds the production route from hop.config.json.
  "dev": { "port": 4696 },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hop",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "SHORT_DOMAIN": "go.localhost:4696",
    "ACCESS_TEAM_DOMAIN": "https://your-team.cloudflareaccess.com",
    "ACCESS_AUD": "your-access-application-aud-tag",
    "ROOT_REDIRECT_URL": ""
  }
}
