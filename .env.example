# Settings for the Docker preset (compose.yaml). `npm run setup:docker` writes .env for you;
# this file shows every value if you'd rather write it by hand. Never commit .env.

# Hop
SHORT_DOMAIN=go.example.com
ROOT_REDIRECT_URL=
# cloudflare only if every request reaches this host through Cloudflare; otherwise none
GEO_SOURCE=none

# Sign-in: oauth2-proxy, authelia or access. COMPOSE_PROFILES must match AUTH_PROVIDER.
AUTH_PROVIDER=oauth2-proxy
COMPOSE_PROFILES=oauth2-proxy
# proxy for oauth2-proxy and authelia, access for access
AUTH_MODE=proxy
# At least 32 random characters, e.g. `openssl rand -base64 32 | tr -d '/+='`
PROXY_SECRET=

# oauth2-proxy (docker/oauth2-proxy/emails.txt lists allowed addresses, one per line)
# Provider: google, github, entra-id or oidc; the issuer URL is only needed for entra-id and oidc.
OAUTH2_PROXY_PROVIDER=google
OAUTH2_PROXY_OIDC_ISSUER_URL=
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
# 32 characters, e.g. `openssl rand -hex 16`
OAUTH2_PROXY_COOKIE_SECRET=
OAUTH2_PROXY_EMAIL_DOMAINS=example.com

# Authelia (users in docker/authelia/users.yml); 64 random characters each
AUTHELIA_SESSION_SECRET=
AUTHELIA_STORAGE_ENCRYPTION_KEY=
AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET=

# Cloudflare Access through a Cloudflare Tunnel
ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
ACCESS_AUD=
TUNNEL_TOKEN=
