{
  "name": "hop",
  "version": "0.2.0",
  "description": "Self-hosted URL shortener for teams on Cloudflare Workers or Docker, with analytics, smart routing and sign-in handled in front of it.",
  "license": "MIT",
  "homepage": "https://github.com/mahdi-ninja/hop#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mahdi-ninja/hop.git"
  },
  "bugs": {
    "url": "https://github.com/mahdi-ninja/hop/issues"
  },
  "keywords": [
    "url-shortener",
    "link-shortener",
    "cloudflare-workers",
    "cloudflare-d1",
    "docker",
    "sqlite",
    "cloudflare-access",
    "self-hosted",
    "analytics",
    "qr-code"
  ],
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "node scripts/ensure-dev-vars.mjs && npm run build:dashboard && wrangler dev",
    "dev:dashboard": "npm --workspace dashboard run dev",
    "build:dashboard": "npm --workspace dashboard run build",
    "build:node": "npm run build:dashboard && node scripts/build-node.mjs",
    "setup": "node scripts/setup.mjs",
    "setup:docker": "node scripts/setup-docker.mjs",
    "doctor": "node scripts/doctor.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && npm --workspace dashboard run typecheck",
    "test": "npm run check:boundaries && vitest run",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "db:migrate:local": "wrangler d1 migrations apply hop --local",
    "db:migrate:remote": "node scripts/deploy.mjs migrate",
    "db:seed:local": "node scripts/seed-local.mjs",
    "deploy": "node scripts/deploy.mjs",
    "cf-typegen": "wrangler types --strict-vars=false"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.10",
    "jose": "^6.2.12",
    "ua-parser-js": "^1.0.41"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@types/node": "^24.19.0",
    "@types/ua-parser-js": "^0.7.39",
    "esbuild": "0.28.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.143.0"
  },
  "allowScripts": {
    "workerd@1.20260815.1": true,
    "workerd@1.20260926.1": true,
    "esbuild@0.28.1": true,
    "fsevents": false
  },
  "workspaces": [
    "dashboard"
  ],
  "overrides": {
    "sharp": "^0.35.4"
  }
}
