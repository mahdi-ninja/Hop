{
  "name": "hop",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:dashboard && wrangler dev",
    "dev:dashboard": "npm --workspace dashboard run dev",
    "build:dashboard": "npm --workspace dashboard run build",
    "typecheck": "tsc --noEmit && npm --workspace dashboard run typecheck",
    "test": "npm run check:boundaries && vitest run",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "db:migrate:local": "wrangler d1 migrations apply hop --local",
    "db:migrate:remote": "wrangler d1 migrations apply hop --remote",
    "db:seed:local": "node scripts/seed-local.mjs",
    "deploy": "npm run build:dashboard && wrangler deploy",
    "cf-typegen": "wrangler types --strict-vars=false"
  },
  "dependencies": {
    "hono": "^4.13.9",
    "jose": "^6.2.12",
    "ua-parser-js": "^1.0.41"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@types/ua-parser-js": "^0.7.39",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.142.0"
  },
  "allowScripts": {
    "workerd@1.20260815.1": true,
    "workerd@1.20260926.1": true,
    "esbuild@0.28.1": true,
    "fsevents": false
  },
  "workspaces": [
    "dashboard"
  ]
}
